<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hint"
            android:textColor="#FF8A90A8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/group_volume"
            android:textColor="#FF8A90A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setIce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_ice" />

        <Button
            android:id="@+id/setClassic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_classic" />

        <Button
            android:id="@+id/setScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_scope" />

        <Button
            android:id="@+id/setDots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_dots" />

        <Button
            android:id="@+id/setVu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_vu" />

        <Button
            android:id="@+id/setRadial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_radial" />

        <Button
            android:id="@+id/setLightshow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_lightshow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/group_no_volume"
            android:textColor="#FF8A90A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/setFft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_fft" />

        <Button
            android:id="@+id/setOctave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_octave" />

        <Button
            android:id="@+id/setWaterfall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_waterfall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/group_settings"
            android:textColor="#FF8A90A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/audio_needed"
            android:textColor="#FFB0B4C8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_audio" />

        <Button
            android:id="@+id/openLab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_lab" />

        <Button
            android:id="@+id/openColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_colors" />

        <Button
            android:id="@+id/openFx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fx_title" />

        <Button
            android:id="@+id/openInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_info" />

        <Button
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/lang_button" />

        <Button
            android:id="@+id/openListener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/open_listener" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/micSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/feat_mic"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/tilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/feat_tilt"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/feat_nowplaying"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/touchFx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/feat_touch"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/haptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/feat_haptics"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</ScrollView>
