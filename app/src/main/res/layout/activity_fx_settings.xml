<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101014"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/fx_title"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fx_hint"
            android:textColor="#FF8A90A8"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bgGradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/feat_bg"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fxFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fx_flash"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fxCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fx_cycle"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fxWaves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fx_waves"
            android:textColor="#FFFFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fxTrails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fx_trails"
            android:textColor="#FFFFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#FF2A2C36" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/party"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/fx_party"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/fx_party_hint"
            android:textColor="#FF8A90A8"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
